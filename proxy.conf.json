{
  "/api/moderate": {
    "target": "https://unidesportal.org",
    "secure": true,
    "changeOrigin": true,
    "logLevel": "debug",
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json"
    }
  },
  "/chatbot": {
    "target": "https://unidesportal.org",
    "secure": true,
    "changeOrigin": true,
    "logLevel": "debug",
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json"
    }
  },
  "/api/**": {
    "target": "https://unidesportal.org",
    "secure": true,
    "changeOrigin": true,
    "logLevel": "debug",
    "ws": true,
    "headers": {
      "Accept": "application/json",
      "Origin": "https://unidesportal.org"
    }
  },
  "/spam-check": {
    "target": "https://unidesportal.org",
    "secure": true,
    "changeOrigin": true,
    "logLevel": "warn",
    "pathRewrite": {
      "^/spam-check": "/api/moderate"
    },
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json"
    }
  },
  "/ImagesUnides/**": {
    "target": "https://unidesportal.org",
    "secure": true,
    "changeOrigin": true,
    "logLevel": "debug"
  }
}